# Copy to .env ONLY for local experiments. Real hosts take these from their dashboard.
# There are no secrets in this project: players are identified by random tokens the server
# generates itself. Never commit a real .env file (it is git-ignored).

# --- Server (apps/server) ---------------------------------------------------------------
# Production mode: serves the built web app, enables strict same-origin rules, ignores BUSY_SCALE.
NODE_ENV=production

# Port to listen on. Hosts normally provide this automatically; do not hardcode it there.
PORT=3001

# Number of reverse proxies in front of the server (hosting platforms: 1). Leave unset when the
# server is reached directly (local use). Setting it without a proxy lets clients fake their IP.
# TRUST_PROXY=1

# Only needed if the page is served from a DIFFERENT address than the server (not the default
# single-service setup), or if your proxy rewrites the Host header. Comma-separated origins.
# CLIENT_ORIGIN=https://game.example.com
# PUBLIC_ORIGIN=https://game.example.com
# (On Render the service's own URL is detected automatically from RENDER_EXTERNAL_URL.)

# Optional: header a trusted CDN sets to the real client IP, e.g. cf-connecting-ip.
# Only set this if you have confirmed the platform always sets it; see docs/DEPLOYMENT.md.
# CLIENT_IP_HEADER=cf-connecting-ip

# Temporary debugging aid for checking client-IP detection. Prints each connecting IP. Remove afterwards.
# LOG_CONNECTIONS=1

# --- Development / testing only ---------------------------------------------------------
# Shortens animation pacing (0..1). Ignored when NODE_ENV=production.
# BUSY_SCALE=0.2

# --- Frontend build (apps/web), baked in at build time ----------------------------------
# Only if the Socket.IO server is on a different address than the page. Default: same origin.
# VITE_SERVER_URL=https://game-server.example.com
