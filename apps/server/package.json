{
  "name": "@lastshell/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --external:express --external:socket.io --external:zod --sourcemap --log-level=warning",
    "start:prod": "node dist/index.mjs",
    "smoke": "vitest run tests/smoke"
  },
  "dependencies": {
    "@lastshell/shared": "*",
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4"
  }
}
